# Separate multiple origins with commas. Use * only for a fully public API.
CORS_ORIGINS=http://localhost:5173

# Optional until an authorized consumer explicitly requests MongoDB.
# Reserved example domain; not a working cluster or a credential.
# Use an explicit database (<64 UTF-8 bytes); percent-encode credentials.
# Validation does not authorize an environment or verify TLS/network/access.
MONGODB_URI=mongodb://mongodb.example.invalid:27017/agro_example
# Integer from 100 to 30000 ms; default 5000. No connection occurs at startup.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
