@startuml
!theme plain
top to bottom direction
skinparam linetype ortho
title Agro - modelo conceptual BE-02 para revision
note "Colecciones convencionales. No Time Series.\nSin inspeccion de Atlas; tipos fisicos y lotes pendientes.\nLos nombres de clases no confirman colecciones existentes.\nDetalle y propuestas BSON en INFORME_BE02_MODELO_DATOS.md." as N
class clientes {
  _id: IdCliente
  nombre: string
}
class usuarios {
  _id: IdUsuario
  entityId: IdCliente
  identidad: pendiente
}
class campos {
  _id: IdCampo
  entityId: IdCliente
  nombre: string
}
class areas {
  _id: IdArea
  entityId: IdCliente
  campoId: IdCampo
  nombre: string
}
class "Dispositivo - catalogo confiable" as dispositivos {
  entityId: IdCliente
  campoId: IdCampo
  areaId: IdArea
  deviceId: IdPublico
  aliasMQTT: IdMQTT opcional
}
note right of dispositivos
  Catalogo separado o campos protegidos: por acordar.
  No autorizar desde el merge libre de ingesta.
  No transferir historicos por reasignacion actual.
end note
class mediciones {
  _id: IdFisico
  referenciaDispositivo: pendiente
  referenciaCliente: pendiente
  timestampAdquisicion: pendiente
  timestampRecepcion: pendiente
  payloadBruto: object
  procedencia: pendiente
}
class alertas <<opcional>> {
  cliente: IdCliente
  dispositivo: IdDispositivo
  origen: pendiente
  cicloDeVida: pendiente
}
clientes "1" -- "0..*" usuarios
clientes "1" -- "0..*" campos
campos "1" -- "0..*" areas
areas "1" -- "0..*" dispositivos
dispositivos "1" -- "0..*" mediciones
dispositivos "1" -- "0..*" alertas
@enduml
