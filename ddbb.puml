@startuml
!theme plain
top to bottom direction
skinparam linetype ortho
title Agro - modelo conceptual propuesto BE-01
note "Colecciones convencionales. No Time Series.\nIDs, nombres BSON y lotes pendientes de BE-02.\nNo representa el estado fisico observado de Atlas." as N
class clientes {
  _id: IdCliente
  nombre: string
}
class usuarios {
  _id: IdUsuario
  entityId: IdCliente
  identidad: pendiente
}
class campos {
  _id: IdCampo
  entityId: IdCliente
  nombre: string
}
class areas {
  _id: IdArea
  entityId: IdCliente
  campoId: IdCampo
  nombre: string
}
class dispositivos {
  _id: IdFisico
  entityId: IdCliente
  campoId: IdCampo
  areaId: IdArea
  deviceId: IdPublico
  clientid: IdMQTT
}
class mediciones {
  _id: IdFisico
  referenciaDispositivo: pendiente
  referenciaCliente: pendiente
  timestampAdquisicion: pendiente
  timestampRecepcion: pendiente
  payloadBruto: object
  procedencia: pendiente
}
class alertas <<opcional>> {
  cliente: IdCliente
  dispositivo: IdDispositivo
  origen: pendiente
  cicloDeVida: pendiente
}
clientes "1" -- "*" usuarios
clientes "1" -- "*" campos
campos "1" -- "*" areas
areas "1" -- "*" dispositivos
dispositivos "1" -- "*" mediciones
dispositivos "1" -- "*" alertas
@enduml
